// The built-in gestures. A quick flick of a pinch or fist is a herdr
// command (see the states below). A pinch works like a finger on a touchscreen: a
// tap clicks where it closed, moving drags, holding still then letting go
// right-clicks. A fist that moves drags the window under the pointer
// (Super + left button, the window manager's window drag); a fist pushed
// toward the camera toggles full screen (Super + F).
(
    gestures: [
        (
            pose: Pinch,
            // A hand closing into a fist reads as a pinch for about 100 ms
            // on the way, and mustn't click.
            settle_ms: 120,
            start: "pinch",
            states: {
                "pinch": (
                    label: "🤏 Pinch",
                    pointer: Frozen,
                    on: [
                        // A quick flick is a herdr command: Alt + left/right
                        // steps through tabs, Alt + up/down through workspaces.
                        (when: [Flicked(Left, 0.1, 200)], to: "tab_left"),
                        (when: [Flicked(Right, 0.1, 200)], to: "tab_right"),
                        (when: [Flicked(Up, 0.1, 200)], to: "workspace_up"),
                        (when: [Flicked(Down, 0.1, 200)], to: "workspace_down"),
                        (when: [Pose(Open, 30)], to: "tap"),
                        (when: [Pose(Fist, 30)], to: "fist_forming"),
                        // A move waits out the flick first.
                        (when: [Moved(0.02), After(200)], to: "drag"),
                        (when: [After(600)], to: "long_press"),
                    ],
                ),
                "long_press": (
                    label: "🤏 Right click",
                    pointer: Frozen,
                    on: [
                        (when: [Pose(Open, 30)], to: "right_click"),
                        (when: [Pose(Fist, 30)], to: "fist_forming"),
                        (when: [Moved(0.02)], to: "drag"),
                    ],
                ),
                "drag": (
                    label: "🤏 Drag",
                    holds: [Left],
                    on: [
                        (when: [Pose(Open, 30)], to: "dropped"),
                        (when: [Pose(Fist, 30)], to: "dropped"),
                    ],
                ),
                // Each holds until the pinch opens, so letting go doesn't click.
                "tab_left": (
                    label: "🤏 ← Tab",
                    pointer: Frozen,
                    enter: [Press(Alt), Press(ArrowLeft), Release(ArrowLeft), Release(Alt)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "tab_right": (
                    label: "🤏 → Tab",
                    pointer: Frozen,
                    enter: [Press(Alt), Press(ArrowRight), Release(ArrowRight), Release(Alt)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "workspace_up": (
                    label: "🤏 ↑ Workspace",
                    pointer: Frozen,
                    enter: [Press(Alt), Press(ArrowUp), Release(ArrowUp), Release(Alt)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "workspace_down": (
                    label: "🤏 ↓ Workspace",
                    pointer: Frozen,
                    enter: [Press(Alt), Press(ArrowDown), Release(ArrowDown), Release(Alt)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "tap": (enter: [Press(Left), Release(Left)]),
                "right_click": (enter: [Press(Right), Release(Right)]),
                // Tightening into a fist was the fist forming: no click.
                "fist_forming": (),
                "dropped": (),
            },
        ),
        (
            pose: Fist,
            settle_ms: 30,
            start: "fist",
            states: {
                "fist": (
                    label: "✊ Fist",
                    pointer: Frozen,
                    on: [
                        (when: [Pushed(0.08)], to: "full_screen"),
                        // A quick flick is a herdr command: Ctrl + Alt +
                        // h/j/k/l moves the focus to the next pane that way.
                        (when: [Flicked(Left, 0.1, 200)], to: "pane_left"),
                        (when: [Flicked(Right, 0.1, 200)], to: "pane_right"),
                        (when: [Flicked(Up, 0.1, 200)], to: "pane_up"),
                        (when: [Flicked(Down, 0.1, 200)], to: "pane_down"),
                        (when: [Pose(Open, 30)], to: "dropped"),
                        // A still fist waits: people settle it before pushing.
                        // A move waits out the flick first.
                        (when: [Moved(0.02), After(200)], to: "window_drag"),
                    ],
                ),
                // Each holds until the fist opens, so the flick's
                // follow-through can't start a window drag.
                "pane_left": (
                    label: "✊ ← Pane",
                    pointer: Frozen,
                    enter: [Press(Ctrl), Press(Alt), Press(H), Release(H), Release(Alt), Release(Ctrl)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "pane_right": (
                    label: "✊ → Pane",
                    pointer: Frozen,
                    enter: [Press(Ctrl), Press(Alt), Press(L), Release(L), Release(Alt), Release(Ctrl)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "pane_up": (
                    label: "✊ ↑ Pane",
                    pointer: Frozen,
                    enter: [Press(Ctrl), Press(Alt), Press(K), Release(K), Release(Alt), Release(Ctrl)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "pane_down": (
                    label: "✊ ↓ Pane",
                    pointer: Frozen,
                    enter: [Press(Ctrl), Press(Alt), Press(J), Release(J), Release(Alt), Release(Ctrl)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                // Until the fist opens, so the push's follow-through can't
                // start a window drag.
                "full_screen": (
                    label: "✊ Full screen",
                    pointer: Frozen,
                    enter: [Press(Super), Press(F), Release(F), Release(Super)],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                // A fist opening reads as a pinch on its way: still the fist.
                "window_drag": (
                    label: "✊ Window drag",
                    holds: [Super, Left],
                    on: [(when: [Pose(Open, 30)], to: "dropped")],
                ),
                "dropped": (),
            },
        ),
    ],
)
