{
  "_doc": "Answer keys: what the user MEANT in each clip, from its intent.md (Performed + Expected), not what terrain does today (that's golden.log). Events in order. 'optional' events may happen without counting as misfires. 'control': must a hand take control (true), must none (false), or don't care (null). 'release_within_ms_of_vanish': a held button must be released this soon after the hand leaves. 'intentional_dropouts': hands leave on purpose, so dropouts don't count.",
  "approach_pinch":            {"events": ["fullscreen","fullscreen","fullscreen","fullscreen","fullscreen","fullscreen","fullscreen","fullscreen","fullscreen"], "control": null},
  "drag":                      {"events": ["drag:right"], "control": true},
  "drag_after_hold":           {"events": ["drag:right"], "control": true},
  "fast_drag_blur":            {"events": ["drag:right"], "control": true, "release_within_ms_of_vanish": 300, "note": "PENDING #19; blur opens the pinch early today"},
  "fist_drag":                 {"events": ["window_drag:right"], "control": true},
  "fist_flicks":               {"events": ["pane:left","pane:right","pane:up","pane:down"], "control": true, "note": "PENDING #28"},
  "fist_forming":              {"events": [], "optional": ["window_drag"], "control": true},
  "fist_push":                 {"events": ["window_drag"], "control": true},
  "full_screen_motion":        {"events": ["fullscreen","fullscreen","fullscreen"], "control": false},
  "leave_mid_drag":            {"events": ["drag:right"], "control": true, "release_within_ms_of_vanish": 300},
  "leave_mid_drag_after_hold": {"events": ["drag:right"], "control": true, "release_within_ms_of_vanish": 300},
  "long_press":                {"events": ["right_click"], "control": true},
  "not_full_screen":           {"events": [], "control": null, "intentional_dropouts": true},
  "pinch_flicks":              {"events": ["nav:left","nav:right","nav:up","nav:down"], "control": true},
  "slow_drags":                {"events": ["drag:left","drag:right","drag:up","drag:down"], "control": true},
  "spread_in_control":         {"events": ["fullscreen","fullscreen","fullscreen","fullscreen","fullscreen"], "control": true},
  "spread_short":              {"events": ["fullscreen","fullscreen","fullscreen","fullscreen","fullscreen","fullscreen","fullscreen"], "control": null, "note": "7 performed; intent.md expects 6 because one loses a hand for 600 ms. Coasting could recover it."},
  "tap":                       {"events": ["click"], "control": true},
  "typing":                    {"events": [], "control": false},
  "vee_down":                  {"events": ["scroll:down"], "control": true},
